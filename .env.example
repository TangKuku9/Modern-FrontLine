# 现代战线 · 权威对局服务 —— 部署配置模板
#
# ⚠ 这个文件**不会被服务自动读取**（服务端零依赖，没有 dotenv）。它是一份**清单**，
#   不是一份生效的配置。要让它生效，三选一：
#     · Docker：  docker run --env-file .env ...
#     · compose： 在 service 里写 env_file: [.env]
#     · 直接跑：  set -a; . ./.env; set +a; node server/net-server.mjs
#   "我改了 .env 但没生效"和"我压根没配"这两件事在日志里长得一样 —— 所以先读这一行。
#
# 用法：cp .env.example .env，改掉里面必须改的两项，然后按上面的方式喂进去。
# 每一项的默认值与作用在 README 的「环境变量」一节里；这里只写**设错会怎样**。

# ══════════ 生产模式必填（不填会拒绝启动）══════════
# 生产模式 = NODE_ENV=production 或 --prod。这两项不填的话，服务打印一段说明后退出（退出码 1）：
#   · 忘了设 JOIN_CODE 时，源码里有一个**公开的**默认邀请码，而日志会说"已设" —— 门是开的，你看不出来。
#   · 忘了设 ACCOUNTS_DB 而又要账号（REQUIRE_ACCOUNT 默认 1）时，账号库是内存的 ——
#     进程一重启，所有人的账号一起消失，而那件事只在重启之后才看得出来。
# 不做生产时（本机 `npm start`）这两项都不必填，服务照常起，日志会写明"在用源码里的默认值"。

# 注册邀请码。给一个只有你知道的值；**显式设成空 = 开放注册**（公开运营时才这么配）。
JOIN_CODE=CHANGE-ME-BEFORE-DEPLOY

# 账号库路径（SQLite，零依赖）。容器里记得把它的目录挂成卷，否则容器一重建档案就没了。
# 明确不想要档案（访客可玩的服）时，改成设 REQUIRE_ACCOUNT=0 并让这一行留空。
ACCOUNTS_DB=/data/accounts.db

# ══════════ 生产模式强烈建议 ══════════
# 允许的来源，逗号分隔。留空 = **不检查**：WebSocket 不受 CORS 约束，不检查来源等于
# 对所有网站开放这台对局服务（别人可以把它嵌进自己的页面当免费炮台，或者替访客占你名额）。
ALLOW_ORIGIN=https://your.domain

# 反代层数，**不是布尔**。背后真有 nginx/Caddy 时填 1；没有反代时保持 0。
# 认了 X-Forwarded-For 而背后其实没有代理 = 把限流 key 交给攻击者自己填。
TRUST_PROXY=1

# 会话 cookie 的 Secure 属性。1 = 只在 HTTPS 下发送（默认跟随生产模式 = 1）。
# ⚠ 明文 HTTP 部署必须设 0，否则浏览器会**静默丢掉**这个 cookie，症状是"登录成功但一刷新又没登"。
COOKIE_SECURE=1

# ══════════ 常规项（默认值通常就够）══════════
# 监听
PORT=8090
HOST=0.0.0.0
# 该实例跑的地图与玩法随机流种子
MAP=yard
SEED=20260925
# 容量上限
MAX_ROOMS=32
MAX_CLIENTS=128
MAX_PAYLOAD=65536
ROOM_IDLE_MS=60000
STATIC_MAX_AGE=86400
SHUTDOWN_GRACE_MS=4000
# 账号门槛与限流
REQUIRE_ACCOUNT=1
REG_PER_HOUR=8
LOGIN_PER_5MIN=12
# 长连接的三个闸门（这三个是"一个人就能把服务器关门"的那一类，别关掉）
CONNS_PER_IP=6
WS_MSG_PER_SEC=240
ROOMS_PER_USER=2
